    "suppressor_flag": null
  },
  {
    "sig_id": "SIG-6",
    "name": "unlicensed_architecture_claim",
    "taxonomy": "confident_fluency_over_verification",
    "patterns": [
      "\\bthere'?s? no mechanism (?:that|for|to)\\b.{0,40}\\b(?:forces?|binds?|compels?)\\b",
      "\\bdon'?t compile into a (?:binding )?constraint\\b",
      "\\bevery response is a fresh choice\\b",
      "\\bI (?:can'?t|cannot|don'?t) (?:see|verify|inspect) (?:my own|this) (?:design|architecture|weights|training)\\b(?![^.]*\\[INFERENCE\\])"
    ],
    "suppressor_flag": null
  }
]
